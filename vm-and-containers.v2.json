      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "VM network receive",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "rate(node_network_receive_bytes_total{job=\"node-exporter\",origin_prometheus=\"lab\",device!=\"lo\"}[$__rate_interval])",
                        "legendFormat": "{{device}}"
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
