      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Container memory working set",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (name) (container_memory_working_set_bytes{job=\"cadvisor\",origin_prometheus=\"lab\",name!=\"\"})",
                        "legendFormat": "{{name}}"
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "prometheus"
